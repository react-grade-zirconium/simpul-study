# SIMPUL STUDY server settings
# Replit/Render/Railway may set PORT automatically. For local/Replit webview, 5000 is recommended.
PORT=5000
HOST=0.0.0.0

# Change this before sharing the site with students.
ADMIN_PASSWORD=change-this-admin-password

# Runtime analytics storage. Files in data/ are intentionally ignored by git.
USAGE_DATA_DIR=data
USAGE_DATA_FILE=usage-stats.json
